{
  "manifest_version": 3,
  "name": "yt-time",
  "version": "0.0.0",
  "description": "Remembers where you left off in a YouTube video, no account needed.",
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-time@xsaveopt",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg",
    "128": "icon.svg"
  },
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "yt-time",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  }
}
